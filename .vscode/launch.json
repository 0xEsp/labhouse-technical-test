// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    // LOCAL
    {
      "name": "labhouse-debug",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define-from-file=.env/secrets.json"
        // "--dart-define=MY_HARDCODED_VAR=some_value",
      ]
    },
    {
      "name": "labhouse-profile",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define-from-file=.env/secrets.json"]
    },
    {
      "name": "labhouse-release",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=.env/secrets.json"]
    },
    // TESTING
    {
      "name": "labhouse-tests",
      "type": "dart",
      "request": "launch",
      "program": "test/" // or test/foo for a subset of tests
    }
  ]
}
